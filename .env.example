# =====================================================================
# LLM EVALS CONFIGURATION (.env.example)
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Document Processing & Chunking Parameters
# ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------------------------------------------------------------------
# Retriever & Vector Store (Chroma DB) Parameters
# ---------------------------------------------------------------------
TOP_K=4
SEARCH_TYPE=similarity          # Options: similarity, mmr
COLLECTION_NAME=evals_collection

# ---------------------------------------------------------------------
# Embedding Model Configuration
# ---------------------------------------------------------------------
# Local HuggingFace sentence transformer (runs on CPU, no API key needed)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------
# LLM Model Configuration
# ---------------------------------------------------------------------
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.0
MAX_TOKENS=1024

# ---------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------
# Required when invoking Groq LLMs (e.g. llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Required if using OpenAI models or embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Hugging Face token (if downloading private/gated models)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Optional: DeepEval / Confident AI platform key (for remote eval dashboards)
# CONFIDENT_AI_API_KEY=your_confident_ai_key_here
